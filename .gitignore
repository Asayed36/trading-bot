__pycache__/
*.pyc
demo_data/
# Everything in data/ stays local, except the paper-trading records (main and
# early strategy) that the scheduled GitHub Actions run saves back to the repository.
data/*
!data/journal.csv
!data/positions.json
!data/entries.csv
!data/schedule.json
!data/health.json
!data/early/
data/early/*
!data/early/journal.csv
!data/early/positions.json
!data/early/entries.csv
!data/convergence/
data/convergence/*
!data/convergence/journal.csv
!data/convergence/positions.json
!data/convergence/entries.csv
!data/news/
data/news/*
!data/news/journal.csv
!data/news/positions.json
!data/news/entries.csv
!data/news/candidates.csv
!data/news/unmatched.csv
!data/news/ai_verdicts.csv
!data/robinhood/
data/robinhood/*
!data/robinhood/journal.csv
!data/robinhood/positions.json
!data/robinhood/entries.csv
!data/robinhood/candidates.csv
# The launch strategy (run on your own server) pushes these; its state.json
# (memory of recent launches) stays on the server.
!data/launch/
data/launch/*
!data/launch/launches.csv
!data/launch/stats.json
!data/launch/*/
data/launch/*/*
!data/launch/*/journal.csv
!data/launch/*/positions.json
!data/launch/*/entries.csv
# The main (1 min) strategy (run on your own server) pushes these.
!data/main-1min/
data/main-1min/*
!data/main-1min/journal.csv
!data/main-1min/positions.json
!data/main-1min/entries.csv
!data/main-1min/health.json
# ...and its paper versions (data/main-1min/a/, data/main-1min/b/, ...).
!data/main-1min/*/
data/main-1min/*/*
!data/main-1min/*/journal.csv
!data/main-1min/*/positions.json
!data/main-1min/*/entries.csv
# The news listings bot (run on your own server) pushes these.
!data/news-listings/
data/news-listings/*
!data/news-listings/journal.csv
!data/news-listings/positions.json
!data/news-listings/entries.csv
!data/news-listings/candidates.csv
!data/news-listings/unmatched.csv
!data/news-listings/ai_verdicts.csv
!data/news-listings/health.json
# The trade feed probe (a one-off measurement on your server) pushes only
# its summary.
!data/trade-feed-probe/
data/trade-feed-probe/*
!data/trade-feed-probe/summary.json
# The momentum strategy (run on your own server) pushes these; its state.json
# (memory of recent launches) stays on the server.
!data/momentum/
data/momentum/*
!data/momentum/near_misses.csv
!data/momentum/stats.json
!data/momentum/health.json
!data/momentum/*/
data/momentum/*/*
!data/momentum/*/journal.csv
!data/momentum/*/positions.json
!data/momentum/*/entries.csv

# The automatic repair's working files (never committed).
.repair/
