# Pushes the server's paper results (data/launch, data/main-1min) to GitHub.
# Started once an hour by launch-push.timer.
[Unit]
Description=Push the server's paper results (launch, main 1 min) to GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bot
WorkingDirectory=/home/bot/trading-bot
ExecStart=/home/bot/trading-bot/deploy/push_results.sh
NoNewPrivileges=true
PrivateTmp=true
